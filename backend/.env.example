
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
APP_ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
MAX_CONCURRENT_TRIP_PLANS=4
DAILY_AVAILABLE_MINUTES=720
DAILY_MEAL_BUFFER_MINUTES=180

# PostgreSQL（请替换用户名、密码和数据库名）
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/trip_planner

# Redis 与 Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_SOFT_TIME_LIMIT_SECONDS=1140
CELERY_TIME_LIMIT_SECONDS=1200
PLANNING_JOB_STALE_MINUTES=35
PLANNING_JOB_RETENTION_DAYS=30

# 认证、外部服务与规划任务限流
AUTH_RATE_LIMIT_PER_10_MINUTES=20
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=60
TRIP_PLAN_RATE_LIMIT_PER_HOUR=10
MAX_ACTIVE_JOBS_PER_USER=3

# 登录会话。生产环境启用 HTTPS 后改为 true
SESSION_COOKIE_NAME=trip_session
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=7

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
